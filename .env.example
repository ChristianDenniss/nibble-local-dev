# Optional: override token for docker compose build.
# By default, `make build` uses your `gh auth login` session (see README).
# GITHUB_TOKEN=

# Sign-in (api-engine). Email + password works with no config; SSO buttons stay
# disabled until a provider's credentials are set. See README "Sign-in".
# OAUTH_CALLBACK_BASE_URL=http://localhost:5174/api
# AUTH_COOKIE_SECURE=false

# Google: OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: http://localhost:5174/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple: Services ID + Sign in with Apple key. Apple only accepts HTTPS redirect
# URIs, so this needs a public HTTPS origin (e.g. a tunnel) and AUTH_COOKIE_SECURE=true.
# APPLE_CLIENT_ID=com.example.nibble.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Contents of the .p8 key; literal \n sequences are converted to newlines.
# APPLE_PRIVATE_KEY=
